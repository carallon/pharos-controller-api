    "version": "0.2.0",
    "configurations": [
        {
            "name": "Build and display (Designer)",
            "type": "PowerShell",
            "request": "launch",
            "script": "$env:PRODUCT = 'designer'; ${workspaceFolder}/make.bat html; Invoke-Item ${workspaceFolder}/build/html/index.html",
            "cwd": "${cwd}"
        },
        {
            "name": "Build and display (Expert)",
            "type": "PowerShell",
            "request": "launch",
            "script": "$env:PRODUCT = 'expert'; ${workspaceFolder}/make.bat html; Invoke-Item ${workspaceFolder}/build/html/index.html",
            "cwd": "${cwd}"
        }
    ]
}